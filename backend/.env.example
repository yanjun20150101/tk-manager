# ==================================================
# TikTok账号管理系统 - 环境变量配置模板
# ==================================================
# 请复制此文件为 .env 并填入真实的配置值
# 注意：.env 文件包含敏感信息，不要提交到版本控制系统
# ==================================================

# --------------------------------------------------
# 应用配置
# --------------------------------------------------
APP_NAME=TikTok账号管理系统
APP_VERSION=1.0.0
# 生产环境请设置为 False
DEBUG=True

# --------------------------------------------------
# 数据库配置 (MySQL)
# --------------------------------------------------
# MySQL服务器地址
MYSQL_HOST=localhost
# MySQL端口
MYSQL_PORT=3306
# MySQL用户名
MYSQL_USER=root
# MySQL密码（请修改为实际密码）
MYSQL_PASSWORD=your_mysql_password
# 数据库名称
MYSQL_DATABASE=tiktok_manager

# --------------------------------------------------
# Redis配置
# --------------------------------------------------
# Redis服务器地址
REDIS_HOST=localhost
# Redis端口
REDIS_PORT=6379
# Redis密码（如果设置了密码）
REDIS_PASSWORD=
# Redis数据库索引
REDIS_DB=0

# --------------------------------------------------
# JWT令牌配置
# --------------------------------------------------
# 密钥（生产环境请使用强随机字符串，至少32位）
# 可以使用以下命令生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production
# 加密算法
ALGORITHM=HS256
# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30
# 刷新令牌过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------------------------------
# CORS跨域配置
# --------------------------------------------------
# 允许的前端源地址，多个地址用逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --------------------------------------------------
# TikTok API配置
# --------------------------------------------------
# TikTok应用Client Key（从TikTok开发者平台获取）
# 申请地址: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
# TikTok应用Client Secret
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
# OAuth授权回调地址（需要与TikTok开发者平台配置一致）
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/tiktok/callback

# --------------------------------------------------
# 文件存储配置
# --------------------------------------------------
# 素材文件存储路径（相对路径或绝对路径）
# 确保该目录存在且应用有读写权限
MEDIA_STORAGE_PATH=./storage/media

# ==================================================
# 配置说明
# ==================================================
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改 .env 中的配置值为实际值
# 3. 确保数据库已创建: mysql -u root -p < scripts/init_db.sql
# 4. 确保Redis服务已启动
# 5. 生产环境务必修改所有密钥和密码
# ==================================================
